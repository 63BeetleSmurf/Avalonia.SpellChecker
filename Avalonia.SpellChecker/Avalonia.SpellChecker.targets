<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<ItemGroup>
		<AvaloniaSpellCheckerDictionary Include="$(MSBuildThisFileDirectory)Dictionaries\*.*" />
		<Content Include="@(AvaloniaSpellCheckerDictionary)"
				 Link="Dictionaries\%(Filename)%(Extension)"
				 TargetPath="Dictionaries\%(Filename)%(Extension)"
				 CopyToOutputDirectory="PreserveNewest"
				 Visible="false"
				 Pack="false" />
	</ItemGroup>
</Project>
