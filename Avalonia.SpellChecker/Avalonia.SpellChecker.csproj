<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<Version>0.3.2</Version>
		<Authors>Gustavo Augusto Hennig</Authors>
		<Company>GH Software Ltda</Company>
		<Description>A spell-checking extension for Avalonia TextBox using WeCantSpell.Hunspell.</Description>
		<PackageTags>spellcheck, Avalonia, WeCantSpell, Hunspell, TextBox</PackageTags>
		<RepositoryUrl>https://github.com/GustavoHennig/Avalonia.SpellChecker</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<Copyright>© 2024-2026 Gustavo Hennig</Copyright>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- Default to latest version -->
		<AvaloniaVersion Condition="'$(AvaloniaVersion)' == ''">12</AvaloniaVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(AvaloniaVersion)' == '11'">
		<TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
		<DefineConstants>AVALONIA_11</DefineConstants>
		<PackageId>GHSoftware.Avalonia.SpellChecker.Avalonia11</PackageId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(AvaloniaVersion)' == '12'">
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<DefineConstants>AVALONIA_12</DefineConstants>
		<PackageId>GHSoftware.Avalonia.SpellChecker</PackageId>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaXaml Remove="SpellCheckerResourceDictionary.axaml" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Dictionaries\es_MX.aff" />
		<None Remove="Dictionaries\es_MX.dic" />
		<None Remove="Dictionaries\pt_BR.aff" />
		<None Remove="Dictionaries\pt_BR.dic" />
		<None Remove="Dictionaries\en_GB.aff" />
		<None Remove="Dictionaries\en_GB.dic" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Dictionaries\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>true</Pack>
			<PackagePath>contentFiles\any\any\Dictionaries\</PackagePath>
			<PackageCopyToOutput>true</PackageCopyToOutput>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="WeCantSpell.Hunspell" Version="6.*" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' OR '$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="WeCantSpell.Hunspell" Version="7.*" />
	</ItemGroup>

	<ItemGroup Condition="'$(AvaloniaVersion)' == '11'">
		<PackageReference Include="Avalonia" Version="[11.1.0,12.0.0)" />
	</ItemGroup>

	<ItemGroup Condition="'$(AvaloniaVersion)' == '12'">
		<PackageReference Include="Avalonia" Version="[12.0.0,13.0.0)" />
	</ItemGroup>
</Project>
